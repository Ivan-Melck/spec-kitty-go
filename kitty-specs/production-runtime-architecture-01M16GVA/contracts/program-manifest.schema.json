{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kitty.org/schemas/program/mission-program-1.0.schema.json",
  "title": "Mission Program Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "title", "missions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "program_id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "critical_path": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/mission" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "idList": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "textList": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "primary_falsification_target",
        "dependencies",
        "entry_evidence",
        "exit_evidence",
        "non_goals",
        "risk",
        "rollback",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "outcome": { "$ref": "#/$defs/text" },
        "primary_falsification_target": { "$ref": "#/$defs/text" },
        "dependencies": { "allOf": [{ "$ref": "#/$defs/idList" }, { "maxItems": 3 }] },
        "entry_evidence": { "$ref": "#/$defs/textList" },
        "exit_evidence": { "$ref": "#/$defs/textList" },
        "non_goals": { "$ref": "#/$defs/textList" },
        "parallel_group": { "$ref": "#/$defs/id" },
        "risk": { "$ref": "#/$defs/text" },
        "rollback": { "$ref": "#/$defs/text" },
        "status": { "enum": ["proposed", "admitted", "active", "blocked", "complete", "superseded", "cancelled"] }
      }
    }
  }
}
