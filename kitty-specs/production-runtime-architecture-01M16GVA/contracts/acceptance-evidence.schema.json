{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kitty.org/schemas/acceptance/evidence-envelope-1.0.schema.json",
  "title": "Acceptance Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "claim_id",
    "mission_id",
    "work_revision_id",
    "candidate_id",
    "outcome",
    "provider",
    "runner",
    "started_at",
    "finished_at",
    "input_digest",
    "result_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "claim_id": { "$ref": "#/$defs/id" },
    "mission_id": { "$ref": "#/$defs/id" },
    "work_revision_id": { "$ref": "#/$defs/id" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "outcome": { "enum": ["pass", "fail", "error", "skipped", "waived"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "binding_revision"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" },
        "binding_revision": { "$ref": "#/$defs/id" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trust_domain"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "trust_domain": { "$ref": "#/$defs/id" }
      }
    },
    "policy_revision": { "$ref": "#/$defs/id" },
    "governance_revision": { "$ref": "#/$defs/id" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "result_digest": { "$ref": "#/$defs/digest" },
    "artifact_digests": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/digest" },
      "uniqueItems": true
    },
    "log_digest": { "$ref": "#/$defs/digest" },
    "diagnostic": { "type": "string", "maxLength": 4096 },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_actor_id", "authority", "reason", "scope", "policy_basis"],
      "properties": {
        "signer_actor_id": { "$ref": "#/$defs/id" },
        "authority": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "scope": { "$ref": "#/$defs/id" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "policy_basis": { "$ref": "#/$defs/id" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "waived" } }, "required": ["outcome"] },
      "then": { "required": ["waiver"] },
      "else": { "not": { "required": ["waiver"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
