{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kitty.dev/schemas/beads-qualification-evidence-v1.json",
  "title": "Beads Qualification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "source_tree",
    "provider_version",
    "provider_digest_sha256",
    "protocol_schema",
    "storage_mode",
    "host",
    "started_at",
    "finished_at",
    "scenarios",
    "authority_invariant_failures",
    "verdict"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provider_version": { "const": "1.2.2" },
    "provider_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protocol_schema": { "const": 1 },
    "storage_mode": { "enum": ["embedded_serialized", "server_multiwriter"] },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch"],
      "properties": {
        "goos": { "type": "string", "minLength": 1, "maxLength": 64 },
        "goarch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runner": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "started", "terminal", "passed", "failed"],
      "properties": {
        "expected": { "const": 11 },
        "started": { "type": "integer", "minimum": 0, "maximum": 11 },
        "terminal": { "type": "integer", "minimum": 0, "maximum": 11 },
        "passed": { "type": "integer", "minimum": 0, "maximum": 11 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "latency": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/latency_observation" }
    },
    "contention": { "$ref": "#/$defs/contention_observation" },
    "assignment_preservation": { "$ref": "#/$defs/assignment_observation" },
    "authority_invariant_failures": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "authority_audits": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "issues": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "message"],
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "verdict": { "enum": ["pass", "fail", "non_admissible"] }
  },
  "$defs": {
    "latency_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "samples", "p50_ms", "p95_ms", "max_ms"],
      "properties": {
        "operation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "samples": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "p50_ms": { "type": "number", "minimum": 0, "maximum": 1800000 },
        "p95_ms": { "type": "number", "minimum": 0, "maximum": 1800000 },
        "max_ms": { "type": "number", "minimum": 0, "maximum": 1800000 }
      }
    },
    "contention_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "processes", "attempted", "terminal", "passed", "collisions", "duplicates", "duration_ms"],
      "properties": {
        "mode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "processes": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "attempted": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "terminal": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "passed": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "collisions": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "duplicates": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "duration_ms": { "type": "number", "minimum": 0, "maximum": 1800000 }
      }
    },
    "assignment_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "terminal", "preserved", "failed", "attribution_lost", "safe_compensation_unsupported"],
      "properties": {
        "attempted": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "terminal": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "preserved": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "attribution_lost": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "safe_compensation_unsupported": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "pass" } },
        "required": ["verdict"]
      },
      "then": {
        "required": ["latency", "contention", "assignment_preservation", "authority_audits"],
        "properties": {
          "storage_mode": { "const": "server_multiwriter" },
          "scenarios": {
            "properties": {
              "expected": { "const": 11 },
              "started": { "const": 11 },
              "terminal": { "const": 11 },
              "passed": { "const": 11 },
              "failed": { "const": 0 }
            }
          },
          "latency": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "operation": { "const": "preflight" },
                    "samples": { "const": 100 },
                    "p95_ms": { "maximum": 1000 }
                  },
                  "required": ["operation", "samples", "p95_ms"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "operation": { "const": "warm_single_item_read" },
                    "samples": { "const": 200 },
                    "p95_ms": { "maximum": 500 }
                  },
                  "required": ["operation", "samples", "p95_ms"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "contention": {
            "properties": {
              "mode": { "const": "server_multiwriter" },
              "processes": { "const": 8 },
              "attempted": { "const": 1000 },
              "terminal": { "const": 1000 },
              "passed": { "const": 1000 },
              "collisions": { "const": 0 },
              "duplicates": { "const": 0 },
              "duration_ms": { "exclusiveMinimum": 0 }
            }
          },
          "assignment_preservation": {
            "properties": {
              "attempted": { "const": 20 },
              "terminal": { "const": 20 },
              "preserved": { "const": 20 },
              "failed": { "const": 0 },
              "attribution_lost": { "const": 10 },
              "safe_compensation_unsupported": { "const": 10 }
            }
          },
          "authority_audits": { "type": "integer", "minimum": 1 },
          "authority_invariant_failures": { "const": 0 },
          "issues": { "maxItems": 0 }
        }
      }
    }
  ]
}
