{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kitty.dev/contracts/artifact-contract.schema.json",
  "title": "Mission Artifact Revision and Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_revision", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_revision_id", "mission_id", "kind", "revision_number", "content_digest", "source_ref", "source_revision", "created_by", "created_at"],
      "properties": {
        "artifact_revision_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["intent", "specification", "plan"]},
        "revision_number": {"type": "integer", "minimum": 1},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_ref": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "findings", "validated_at"],
      "properties": {
        "verdict": {"enum": ["pass", "fail"]},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "field", "message"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        },
        "validated_at": {"type": "string", "format": "date-time"}
      }
    },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approval_id", "artifact_revision_id", "verdict", "actor_id", "evidence_digest", "governance_context_id", "submitted_at"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "artifact_revision_id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["approved", "rejected"]},
        "actor_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "governance_context_id": {"type": "string", "minLength": 1},
        "submitted_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
