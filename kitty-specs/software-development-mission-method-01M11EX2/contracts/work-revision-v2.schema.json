{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kitty.dev/contracts/work-revision-v2.schema.json",
  "title": "WorkRevision v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_revision_id", "project_id", "mission_id", "generation", "planning_source_commit", "mission_definition", "dependency_policy", "work_items", "lanes", "provider_observations", "graph_digest", "criteria_digest", "finalized_by", "finalized_at", "governance_context_id"],
  "properties": {
    "schema_version": {"const": 2},
    "work_revision_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "predecessor_id": {"type": "string"},
    "planning_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "mission_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "digest"],
      "properties": {
        "key": {"const": "software-development"},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dependency_policy": {"enum": ["approved_or_done"]},
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "title", "description", "criteria", "dependencies", "write_scopes"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "design_context": {"type": "string"},
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "text", "verifier_kind", "required"],
              "properties": {
                "criterion_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "verifier_kind": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "metadata": {"type": "object"}
              }
            }
          },
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "write_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane_id", "work_ids", "dependency_lane_ids"],
        "properties": {
          "lane_id": {"type": "string", "minLength": 1},
          "work_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "dependency_lane_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "provider_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "provider", "external_id", "revision"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "external_id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finalized_by": {"type": "string", "minLength": 1},
    "finalized_at": {"type": "string", "format": "date-time"},
    "governance_context_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"generation": {"const": 1}}},
      "then": {"properties": {"predecessor_id": {"maxLength": 0}}},
      "else": {"required": ["predecessor_id"], "properties": {"predecessor_id": {"minLength": 1}}}
    }
  ]
}
