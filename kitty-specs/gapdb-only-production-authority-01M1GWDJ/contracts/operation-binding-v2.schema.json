{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kitty.dev/contracts/operation-binding-v2.schema.json",
  "title": "Spec Kitty Operation Binding v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","operation_id","command_kind","command_schema_version","canonical_intent_sha256","scope","originating_runtime_epoch_id","observed_created_at"],
  "properties": {
    "schema_version": {"const": 2},
    "operation_id": {"type":"string","minLength":1,"maxLength":128},
    "command_kind": {"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},
    "command_schema_version": {"type":"integer","minimum":1,"maximum":65535},
    "canonical_intent_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "scope": {
      "type":"object",
      "additionalProperties": false,
      "required":["kind"],
      "properties": {
        "kind":{"enum":["host","project","mission","repository","work_revision","work"]},
        "project_id":{"type":"string","minLength":1,"maxLength":128},
        "mission_id":{"type":"string","minLength":1,"maxLength":128},
        "repository_id":{"type":"string","minLength":1,"maxLength":128},
        "work_revision_id":{"type":"string","minLength":1,"maxLength":128},
        "work_id":{"type":"string","minLength":1,"maxLength":128}
      }
    },
    "actor_id":{"type":"string","minLength":1,"maxLength":128},
    "process_id":{"type":"string","minLength":1,"maxLength":128},
    "doctrine_revision":{"type":"string","minLength":1,"maxLength":128},
    "profile_revision":{"type":"string","minLength":1,"maxLength":128},
    "policy_revision":{"type":"string","minLength":1,"maxLength":128},
    "originating_runtime_epoch_id":{"type":"string","minLength":1,"maxLength":128},
    "observed_created_at":{"type":"string","format":"date-time"}
  }
}
